<Window x:Class="FastDownloader.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FastDownloader — Native Preview"
        Width="1110" Height="735" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="{DynamicResource CanvasBrush}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
          Background="{DynamicResource CanvasBrush}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="215"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
        <Grid Margin="17,22,17,18">
          <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top">
            <Border Width="39" Height="39" Background="{DynamicResource AccentBrush}"
                    CornerRadius="11" Margin="0,0,10,0">
              <TextBlock Text="↧" Foreground="{DynamicResource AccentTextBrush}"
                         FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="FastDownloader" FontSize="14" FontWeight="Bold"
                         Foreground="{DynamicResource MainTextBrush}"/>
              <TextBlock Text="NATIVE PREVIEW" FontSize="9.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" CharacterSpacing="0"/>
            </StackPanel>
          </StackPanel>

          <TextBlock Grid.Row="1" Text="LIBRARY" FontSize="10" FontWeight="Bold"
                     Foreground="{DynamicResource MutedTextBrush}" Margin="11,4,0,0"/>
          <StackPanel Grid.Row="2">
            <Button x:Name="AllFilter" Content="▦    All downloads" Click="AllFilter_Click"
                    Style="{StaticResource NavigationButton}"
                    Background="{DynamicResource RaisedBrush}"
                    Foreground="{DynamicResource MainTextBrush}"/>
            <Button x:Name="ActiveFilter" Content="↓    Active" Click="ActiveFilter_Click"
                    Style="{StaticResource NavigationButton}"/>
            <Button x:Name="CompletedFilter" Content="✓    Completed" Click="CompletedFilter_Click"
                    Style="{StaticResource NavigationButton}"/>
            <Separator Margin="10,20,10,18" Background="{DynamicResource LineBrush}"/>
            <TextBlock Text="QUICK ACTIONS" FontSize="10" FontWeight="Bold"
                       Foreground="{DynamicResource MutedTextBrush}" Margin="11,0,0,10"/>
            <Button Content="↻    Refresh list" Click="Refresh_Click"
                    Style="{StaticResource NavigationButton}"/>
            <Button Content="◐    Switch theme" Click="Theme_Click"
                    Style="{StaticResource NavigationButton}"/>
          </StackPanel>
          <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                  CornerRadius="10" Padding="12">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ConnectionDot" Width="7" Height="7"
                         Fill="{DynamicResource WarningBrush}" Margin="0,4,8,0"/>
                <TextBlock x:Name="SidebarStatus" Text="Waiting for engine" FontSize="11.5"
                           Foreground="{DynamicResource MainTextBrush}"/>
              </StackPanel>
              <TextBlock Text="Existing download engine" FontSize="10.5"
                         Foreground="{DynamicResource MutedTextBrush}" Margin="15,6,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="30,0,30,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="77"/>
          <RowDefinition Height="107"/>
          <RowDefinition Height="95"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="55"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_Drag">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="DOWNLOAD MANAGER / DESKTOP" FontSize="10.5"
                       FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
            <TextBlock Text="Your downloads" FontSize="23" FontWeight="Bold" Margin="0,4,0,0"
                       Foreground="{DynamicResource MainTextBrush}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="—" Click="Minimize_Click" Width="34" Height="29" Margin="0,0,4,0"
                    Style="{StaticResource TextButton}" FontSize="18"/>
            <Button Content="□" Click="Maximize_Click" Width="34" Height="29" Margin="0,0,4,0"
                    Style="{StaticResource TextButton}" FontSize="15"/>
            <Button Content="×" Click="Close_Click" Width="34" Height="29"
                    Style="{StaticResource TextButton}" FontSize="18"/>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,7,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                  CornerRadius="11" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
            <StackPanel Margin="16,13">
              <TextBlock Text="ACTIVE" FontSize="10.5" FontWeight="Bold"
                         Foreground="{DynamicResource MutedTextBrush}"/>
              <TextBlock x:Name="ActiveCount" Text="—" FontSize="26" FontWeight="Bold"
                         Foreground="{DynamicResource MainTextBrush}" Margin="0,5,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                  CornerRadius="11" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
            <StackPanel Margin="16,13">
              <TextBlock Text="COMPLETE" FontSize="10.5" FontWeight="Bold"
                         Foreground="{DynamicResource MutedTextBrush}"/>
              <TextBlock x:Name="CompleteCount" Text="—" FontSize="26" FontWeight="Bold"
                         Foreground="{DynamicResource MainTextBrush}" Margin="0,5,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="4" Background="{DynamicResource SurfaceBrush}"
                  CornerRadius="11" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
            <StackPanel Margin="16,13">
              <TextBlock Text="SPEED" FontSize="10.5" FontWeight="Bold"
                         Foreground="{DynamicResource MutedTextBrush}"/>
              <TextBlock x:Name="SpeedValue" Text="—" FontSize="20" FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}" Margin="0,9,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="6" Background="{DynamicResource SurfaceBrush}"
                  CornerRadius="11" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
            <StackPanel Margin="16,13">
              <TextBlock Text="QUEUED" FontSize="10.5" FontWeight="Bold"
                         Foreground="{DynamicResource MutedTextBrush}"/>
              <TextBlock x:Name="QueuedCount" Text="—" FontSize="26" FontWeight="Bold"
                         Foreground="{DynamicResource MainTextBrush}" Margin="0,5,0,0"/>
            </StackPanel>
          </Border>
        </Grid>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Transfers" FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource MainTextBrush}"/>
            <TextBlock Text="Live data from your existing download engine" FontSize="11.5"
                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PauseAllButton" Content="Pause all" Click="PauseAll_Click" IsEnabled="False"
                    Style="{StaticResource QuietButton}" Margin="0,0,8,0" Height="37"/>
            <Button x:Name="ResumeAllButton" Content="Resume all" Click="ResumeAll_Click" IsEnabled="False"
                    Style="{StaticResource QuietButton}" Margin="0,0,9,0" Height="37"/>
            <Button x:Name="NewDownloadButton" Content="+  New download" Click="NewDownload_Click"
                    Style="{StaticResource PrimaryButton}" Height="37"/>
          </StackPanel>
        </Grid>

        <Border Grid.Row="3" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"
                Background="{DynamicResource SurfaceBrush}" CornerRadius="12" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="54"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Margin="17,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="ALL TRANSFERS" FontWeight="Bold" FontSize="10.5"
                           Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock x:Name="ListCount" Text="" FontSize="11" Margin="12,0,0,0"
                           Foreground="{DynamicResource AccentBrush}"/>
              </StackPanel>
              <TextBox Grid.Column="1" x:Name="SearchBox" Height="32" Margin="0,10,0,10"
                       Style="{StaticResource InputStyle}" FontSize="12"
                       ToolTip="Search downloads" TextChanged="Search_TextChanged"/>
            </Grid>
            <Grid Grid.Row="1">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,0,12,10">
                <ItemsControl x:Name="DownloadList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource RaisedBrush}" CornerRadius="9"
                              Margin="0,0,0,7" Padding="13,10">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="122"/>
                            <ColumnDefinition Width="78"/>
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                                  Width="27" Height="27" CornerRadius="7" VerticalAlignment="Center">
                            <TextBlock Text="↓" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="15" Foreground="{DynamicResource AccentBrush}"/>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MainTextBrush}"/>
                            <TextBlock Text="{Binding Detail}" FontSize="10.5" Margin="0,5,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" FontSize="10.5"
                                     VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                          <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="5,0,8,0">
                            <TextBlock Text="{Binding ProgressLabel}" FontSize="11" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource MainTextBrush}" Margin="0,0,0,5"/>
                            <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding Progress}"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="{DynamicResource LineBrush}" BorderThickness="0"/>
                          </StackPanel>
                          <Button Grid.Column="4" Content="{Binding ActionLabel}" Tag="{Binding Id}"
                                  Visibility="{Binding ActionVisibility}"
                                  Click="TaskAction_Click" Height="31" Margin="5,0,0,0"
                                  VerticalAlignment="Center" Style="{StaticResource QuietButton}"
                                  FontSize="11" Padding="3,0"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                          Width="410" Margin="0,0,0,14">
                <Border Width="62" Height="62" CornerRadius="17" HorizontalAlignment="Center"
                        Background="{DynamicResource RaisedBrush}" Margin="0,0,0,18">
                  <TextBlock Text="↓" FontSize="32" Foreground="{DynamicResource AccentBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="EmptyHeading" Text="Connecting to your engine"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}"/>
                <TextBlock x:Name="EmptyDetail" Text="This native interface uses real transfer data, never placeholder downloads."
                           TextWrapping="Wrap" TextAlignment="Center"
                           FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" Margin="0,9,0,0"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
        <Grid Grid.Row="4">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="FooterStatus" Text="Preview only · No changes to your installed application"
                     FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                     VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="WPF • Native Windows UI" FontSize="11"
                     Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>